# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/certificate_verification

# JWT
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_random
JWT_EXPIRES_IN=8h

# Blockchain (Polygon Amoy untuk deployment online)
BLOCKCHAIN_RPC=https://polygon-amoy.example-rpc.com
CONTRACT_ADDRESS=0x_your_deployed_contract_address
PRIVATE_KEY=your_wallet_private_key
